#CDIR = Path(cutout_dir).joinpath("" if run["shared_cutouts"] else RDIR)
RESULTS = "results/" + RDIR


WORKFLOW_STAGES = [x.lower() for x in config.get("run", {}).get("workflow_stages")]
EXPORT_FORMAT = config.get("postprocess", {}).get("export_format", None)

# Pre-solve pipeline runs for all stages (builds planning_base_network.nc)
include: "rules/load_network.smk"
include: "rules/add_components.smk"
if config["load"]["load_mode"].upper() != "DEFAULT":  # loads already in base network when DEFAULT
    include: "rules/add_loads.smk"
include: "rules/add_snapshots.smk"
include: "rules/add_representative_days.smk"
include: "rules/add_extra_loads.smk"
include: "rules/modify_components.smk"

# Planning solve (skipped for dispatch-only)
if "planning" in WORKFLOW_STAGES:
    include: "rules/solve_planning.smk"
    include: "rules/post_process_planning.smk"

# Dispatch solve (requires planning_solved_network/ from a prior planning run for dispatch-only)
if "dispatch" in WORKFLOW_STAGES:
    include: "rules/create_dispatch_network.smk"
    include: "rules/solve_dispatch.smk"
    include: "rules/post_process_dispatch.smk"

# Will only include respective corridor map plots if the corresponding workflow stage is active
include: "rules/plot_corridor_map.smk"

# Combined post-processing requires both stages
if set(["planning", "dispatch"]).issubset(WORKFLOW_STAGES):
    include: "rules/create_summary.smk"
    include: "rules/export_idea.smk"

include: "rules/finalize.smk"

def get_all_targets():
    targets = []

    if "planning" in WORKFLOW_STAGES:
        targets += [
            *rules.solve_planning.output,
            *rules.post_process_planning.output,
            *rules.plot_planning_corridor_map.output,
        ]

    if "dispatch" in WORKFLOW_STAGES:
        targets += [
            *rules.solve_dispatch.output,
            *rules.post_process_dispatch.output,
            *rules.plot_dispatch_corridor_map.output,
        ]

    # TODO generate summary that dosen't require both?
    if "planning" in WORKFLOW_STAGES and "dispatch" in WORKFLOW_STAGES:
    # if set(["planning", "dispatch"]).issubset(WORKFLOW_STAGES):
        targets += [*rules.create_summary.output]
        if EXPORT_FORMAT and EXPORT_FORMAT.lower() == "idea":
            targets.append(*rules.export_idea.output)

    targets += [
        *rules.copy_config.output,
        *rules.collect_logs.output,
    ]
    return targets

rule all:
    input:
        get_all_targets()
